---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { publishedNotes, topicGroups } from '../lib/notes';
import { withBase } from '../lib/paths';
const notes = await publishedNotes();
const topics = await topicGroups();
const tags = [...new Set(notes.flatMap((n) => n.data.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
---

<BaseLayout title="全部笔记">
  <header class="page-intro">
    <p class="eyebrow">The library / {String(notes.length).padStart(2, '0')} notes</p>
    <h1>所有值得保存的思想。</h1>
    <p>按原视频发布日期排列。选择一个主题，或带着一个模糊记得的问题去搜索。</p>
    <a class="text-link" href={withBase('search/')}>
      搜索全文 ↗
    </a>
  </header>
  <div class="filters">
    <label>
      主题
      <select id="topic-filter">
        <option value="">全部主题</option>
        {topics.map((t) => (
          <option value={t.title}>{t.title}</option>
        ))}
      </select>
    </label>
    <label>
      关键词标签
      <select id="tag-filter">
        <option value="">全部标签</option>
        {tags.map((t) => (
          <option value={t}>{t}</option>
        ))}
      </select>
    </label>
    <button class="text-link" id="reset-filters" type="button">
      重置
    </button>
    <output id="filter-count" aria-live="polite">
      {notes.length} 篇笔记
    </output>
  </div>
  <div>
    {notes.map((n, i) => (
      <NoteCard note={n} index={i} headingLevel={2} />
    ))}
  </div>
  <p id="filter-empty" class="empty-state" hidden>
    这个组合暂时没有笔记。试着重置筛选，或搜索全文。
  </p>
  <noscript>
    <p class="no-script">筛选需要 JavaScript；全部笔记已列在下方。</p>
  </noscript>
</BaseLayout>
<script>
  const topic = document.querySelector<HTMLSelectElement>('#topic-filter')!;
  const tag = document.querySelector<HTMLSelectElement>('#tag-filter')!;
  const params = new URLSearchParams(location.search);
  if (params.has('topic')) topic.value = params.get('topic')!;
  if (params.has('tag')) tag.value = params.get('tag')!;
  function filter() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-note]').forEach((el) => {
      const show =
        (!topic.value || JSON.parse(el.dataset.topics!).includes(topic.value)) &&
        (!tag.value || JSON.parse(el.dataset.tags!).includes(tag.value));
      el.hidden = !show;
      if (show) count++;
    });
    document.querySelector('#filter-count')!.textContent = `${count} 篇笔记`;
    document.querySelector<HTMLElement>('#filter-empty')!.hidden = count > 0;
    const p = new URLSearchParams();
    if (topic.value) p.set('topic', topic.value);
    if (tag.value) p.set('tag', tag.value);
    history.replaceState(null, '', `${location.pathname}${p.size ? '?' + p : ''}`);
  }
  topic.addEventListener('change', filter);
  tag.addEventListener('change', filter);
  document.querySelector('#reset-filters')!.addEventListener('click', () => {
    topic.value = '';
    tag.value = '';
    filter();
  });
  filter();
</script>
