{
  "name": "tao-knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate": "tsx scripts/kb/validate.ts",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "build": "npm run validate && npm run check && npm run build:site && npm run build:search",
    "preview": "astro preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "new": "tsx scripts/kb/new.ts",
    "publish": "tsx scripts/kb/publish.ts",
    "publish:batch": "tsx scripts/kb/publish-batch.ts",
    "kb:clean": "tsx scripts/kb/clean.ts",
    "kb:compile": "tsx scripts/kb/compile.ts",
    "kb:validate": "tsx scripts/kb/validate.ts",
    "kb:verify": "tsx scripts/kb/verify.ts",
    "test:site": "tsx scripts/test-site.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}
